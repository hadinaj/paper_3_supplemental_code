Table patients {
  subject_id int [pk]
  gender varchar
  anchor_age int
  anchor_year int
  anchor_year_group varchar
}

Table admissions {
  subject_id int
  hadm_id int [pk]
  admittime timestamp
  dischtime timestamp
  admission_type varchar
  admission_location varchar
  discharge_location varchar
  insurance varchar
  language varchar
  marital_status varchar
  race varchar
}

Table diagnoses_icd {
  subject_id int
  hadm_id int
  seq_num int
  icd_code varchar
  icd_version int
}

Table d_icd_diagnoses {
  icd_code varchar
  icd_version int
  long_title varchar
}

Table procedures_icd {
  subject_id int
  hadm_id int
  seq_num int
  chartdate date
  icd_code varchar
  icd_version int
}

Table d_icd_procedures {
  icd_code varchar
  icd_version int
  long_title varchar
}

Table labevents {
  labevent_id int [pk]
  subject_id int
  hadm_id int
  itemid int
  charttime timestamp
  storetime timestamp
  value varchar
  valuenum double
  valueuom varchar
  flag varchar
}

Table d_labitems {
  itemid int [pk]
  label varchar
  fluid varchar
  category varchar
}

Table poe {
  poe_id varchar [pk]
  subject_id int
  hadm_id int
  ordertime timestamp
  order_type varchar
  order_subtype varchar
}

Table prescriptions {
  subject_id int
  hadm_id int
  pharmacy_id int
  poe_id varchar
  drug varchar
  starttime timestamp
  stoptime timestamp
}

Table pharmacy {
  subject_id int
  hadm_id int
  pharmacy_id int [pk]
  poe_id varchar
  medication varchar
  starttime timestamp
  stoptime timestamp
}

Table emar {
  subject_id int
  hadm_id int
  emar_id varchar [pk]
  pharmacy_id int
  charttime timestamp
  medication varchar
  event_txt varchar
}

/* Conservative inferred relationships with complete join-based matches */

Ref: admissions.subject_id > patients.subject_id

Ref: diagnoses_icd.subject_id > patients.subject_id
Ref: diagnoses_icd.hadm_id > admissions.hadm_id
Ref: diagnoses_icd.(icd_code, icd_version) > d_icd_diagnoses.(icd_code, icd_version)

Ref: procedures_icd.subject_id > patients.subject_id
Ref: procedures_icd.hadm_id > admissions.hadm_id
Ref: procedures_icd.(icd_code, icd_version) > d_icd_procedures.(icd_code, icd_version)

Ref: labevents.subject_id > patients.subject_id
Ref: labevents.itemid > d_labitems.itemid

Ref: poe.subject_id > patients.subject_id
Ref: poe.hadm_id > admissions.hadm_id

Ref: prescriptions.subject_id > patients.subject_id
Ref: prescriptions.hadm_id > admissions.hadm_id

Ref: pharmacy.subject_id > patients.subject_id
Ref: pharmacy.hadm_id > admissions.hadm_id

Ref: emar.subject_id > patients.subject_id